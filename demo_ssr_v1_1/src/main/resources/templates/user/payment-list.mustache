{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header mb-0">
            <h4><b>결제 내역</b></h4>
        </div>
        <!-- 외부 카드 -->
        <div class="card-body">

            <!-- 내부 카드(card-body) -->
            {{#paymentList}}
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="card-title mb-0">
                            <i class="fa-solid fa-dollar-sign"></i> 결제 # {{id}}
                        </h5>
                        <span class="badge bg-primary fs-6">+{{price}}</span>
                    </div>
                    <br>
                    <p class="text-muted mb-2">
                        <i class="fa-solid fa-receipt"></i> 주문번호: {{impUid}}
                    </p>
                    <p class="text-muted mb-2">
                        <i class="fa-solid fa-key"></i> 결제번호: {{merchantUid}}
                    </p>
                    <p class="text-muted mb-2">
                        <i class="fa-solid fa-calendar-days"></i> 결제일: {{paymentAt}}
                    </p>
                    <p class="text-muted mb-2">
                        <i class="fa-solid fa-circle-info"></i> 상태:
                        <span class="badge bg-success fs-6">{{status}}</span>
                    </p>
                </div>
            {{/paymentList}}
            <!-- 유료 결제 내역이 없을 경우 -->
            {{^paymentList}}
                <div class="text-center py-5">
                    <h5><i class="fa-solid fa-coins fa-2x"></i>
                        <br><br>
                        결제내역이 없습니다.</h5>
                    <br>
                    <a href="/user/point/charge" class="btn btn-primary">결제 페이지로</a>
                </div>
            {{/paymentList}}
            <div class="mt-4">
                <a href="/user/detail" class="btn btn-secondary">회원 정보로 돌아가기</a>
            </div>
        </div>
    </div>
</div>


{{> layout/footer}}